<?xml version="1.0"?>
<sdf version="1.6">
  <world name="openarm_workcell">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.79 0.86 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 -0.25 -1</direction>
    </light>
    <light name="work_light" type="point">
      <pose>0 -0.7 2.5 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.7</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.25 0.28 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The robot faces -Y; the near edge is 0.405 m in front of its base. -->
