        <collision name="leg_br_collision"><pose>-0.52 0.27 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry></collision>
        <visual name="leg_fl_visual"><pose>0.52 -0.27 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><material><diffuse>0.13 0.15 0.17 1</diffuse></material></visual>
