        <visual name="leg_br_visual"><pose>-0.52 0.27 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><material><diffuse>0.13 0.15 0.17 1</diffuse></material></visual>
      </link>
    </model> -->

    <model name="coffee_mug">
      <pose>-0.25 -0.68 0.555 0 0 0</pose>
      <link name="mug">
        <inertial><mass>0.25</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0003</izz></inertia></inertial>
        <collision name="body"><geometry><cylinder><radius>0.045</radius><length>0.14</length></cylinder></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <collision name="handle_top"><pose>-0.062 0 0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry></collision>
        <collision name="handle_side"><pose>-0.088 0 0 0 0 0</pose><geometry><box><size>0.018 0.018 0.080</size></box></geometry></collision>
        <collision name="handle_bottom"><pose>-0.062 0 -0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry></collision>
        <visual name="body_visual"><geometry><cylinder><radius>0.045</radius><length>0.14</length></cylinder></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
        <visual name="handle_top_visual"><pose>-0.062 0 0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry><material><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
        <visual name="handle_side_visual"><pose>-0.088 0 0 0 0 0</pose><geometry><box><size>0.018 0.018 0.080</size></box></geometry><material><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
        <visual name="handle_bottom_visual"><pose>-0.062 0 -0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry><material><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <model name="water_bottle">
      <!-- Right-arm vision-grasp target. Both the approach and descend poses
           converge with the deployment node's v11 position IK. -->
      <pose>-0.14 -0.44 0.59 0 0 0</pose>
      <link name="bottle">
        <inertial><mass>0.32</mass><inertia><ixx>0.0012</ixx><iyy>0.0012</iyy><izz>0.0003</izz></inertia></inertial>
        <collision name="body"><pose>0 0 -0.015 0 0 0</pose><geometry><cylinder><radius>0.038</radius><length>0.18</length></cylinder></geometry></collision>
        <collision name="neck"><pose>0 0 0.085 0 0 0</pose><geometry><cylinder><radius>0.021</radius><length>0.04</length></cylinder></geometry></collision>
        <visual name="body_visual"><pose>0 0 -0.015 0 0 0</pose><geometry><cylinder><radius>0.038</radius><length>0.18</length></cylinder></geometry><material><ambient>0.08 0.45 0.52 0.85</ambient><diffuse>0.10 0.65 0.75 0.85</diffuse></material></visual>
        <visual name="neck_visual"><pose>0 0 0.085 0 0 0</pose><geometry><cylinder><radius>0.021</radius><length>0.04</length></cylinder></geometry><material><diffuse>0.10 0.65 0.75 0.85</diffuse></material></visual>
        <visual name="cap"><pose>0 0 0.11 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.018</length></cylinder></geometry><material><diffuse>0.08 0.18 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <model name="apple">
      <pose>0.02 -0.66 0.532 0 0 0</pose>
      <link name="apple">
        <inertial><mass>0.16</mass><inertia><ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00013</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.047</radius></sphere></geometry><surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="fruit"><geometry><sphere><radius>0.047</radius></sphere></geometry><material><ambient>0.55 0.03 0.025 1</ambient><diffuse>0.82 0.05 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material></visual>
        <visual name="stem"><pose>0 0 0.052 0 0 0</pose><geometry><cylinder><radius>0.004</radius><length>0.025</length></cylinder></geometry><material><diffuse>0.18 0.08 0.025 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cereal_box">
      <pose>0.43 -0.94 0.585 0 0 0.15</pose>
      <link name="box">
        <inertial><mass>0.28</mass><inertia><ixx>0.0010</ixx><iyy>0.0005</iyy><izz>0.0012</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.10 0.045 0.20</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.10 0.045 0.20</size></box></geometry><material><ambient>0.92 0.48 0.05 1</ambient><diffuse>0.98 0.62 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <model name="food_can">
      <pose>-0.45 -0.88 0.55 0 0 0</pose>
      <link name="can">
        <inertial><mass>0.35</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.13</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.035</radius><length>0.13</length></cylinder></geometry><material><ambient>0.04 0.18 0.55 1</ambient><diffuse>0.06 0.32 0.85 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      </link>
    </model>

    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>1.85 1.45 1.30 0 0.33 -2.45</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
