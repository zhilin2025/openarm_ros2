<?xml version="1.0"?>
<sdf version="1.6">
  <world name="openarm_workcell">
    <gravity>0 0 -9.81</gravity>
    <physics name="ode_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>80</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.79 0.86 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 6 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.35 -0.25 -1</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.4</constant>
        <linear>0.08</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- Gazebo/ROS state services: /gazebo/get_entity_state and
         /gazebo/set_entity_state, used by the bimanual carry node to verify
         and reset object poses between test runs. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>10.0</update_rate>
    </plugin>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.25 0.28 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The robot faces -Y. Table top surface at z = 0.485; the near edge
         sits at y = -0.20, just in front of the robot body. -->
    <model name="work_table">
      <static>true</static>
      <pose>0 -0.70 0 0 0 0</pose>
      <link name="table">
        <collision name="top_collision">
          <pose>0 0 0.46 0 0 0</pose>
          <geometry><box><size>1.30 1.00 0.05</size></box></geometry>
          <surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.46 0 0 0</pose>
          <geometry><box><size>1.30 1.00 0.05</size></box></geometry>
          <material><ambient>0.35 0.24 0.15 1</ambient><diffuse>0.55 0.38 0.24 1</diffuse></material>
        </visual>
        <collision name="leg_fl_collision"><pose>0.58 -0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <collision name="leg_fr_collision"><pose>-0.58 -0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <collision name="leg_bl_collision"><pose>0.58 0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <collision name="leg_br_collision"><pose>-0.58 0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <visual name="leg_fl_visual"><pose>0.58 -0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><material><diffuse>0.13 0.15 0.17 1</diffuse></material></visual>
        <visual name="leg_fr_visual"><pose>-0.58 -0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><material><diffuse>0.13 0.15 0.17 1</diffuse></material></visual>
        <visual name="leg_bl_visual"><pose>0.58 0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><material><diffuse>0.13 0.15 0.17 1</diffuse></material></visual>
        <visual name="leg_br_visual"><pose>-0.58 0.43 0.225 0 0 0</pose><geometry><box><size>0.07 0.07 0.45</size></box></geometry><material><diffuse>0.13 0.15 0.17 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Grasp-test objects. Start poses sit inside the bimanual workspace
         (robot world frame = gazebo z minus the 0.38 m spawn offset). -->
    <model name="water_bottle">
      <pose>0 -0.30 0.56 0 0 0</pose>
      <link name="bottle">
        <inertial><mass>0.32</mass><inertia><ixx>0.0006</ixx><iyy>0.0006</iyy><izz>0.0003</izz></inertia></inertial>
        <collision name="body"><geometry><cylinder><radius>0.038</radius><length>0.15</length></cylinder></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="body_visual"><geometry><cylinder><radius>0.038</radius><length>0.15</length></cylinder></geometry><material><ambient>0.08 0.45 0.52 0.85</ambient><diffuse>0.10 0.65 0.75 0.85</diffuse></material></visual>
        <visual name="cap"><pose>0 0 0.062 0 0 0</pose><geometry><cylinder><radius>0.030</radius><length>0.022</length></cylinder></geometry><material><diffuse>0.08 0.18 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <model name="food_can">
      <pose>0 -0.30 0.55 0 0 0</pose>
      <link name="can">
        <inertial><mass>0.35</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.13</length></cylinder></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><cylinder><radius>0.035</radius><length>0.13</length></cylinder></geometry><material><ambient>0.04 0.18 0.55 1</ambient><diffuse>0.06 0.32 0.85 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      </link>
    </model>

    <model name="cereal_box">
      <pose>0 -0.31 0.56 0 0 0</pose>
      <link name="box">
        <inertial><mass>0.28</mass><inertia><ixx>0.0010</ixx><iyy>0.0005</iyy><izz>0.0012</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.10 0.045 0.15</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><box><size>0.10 0.045 0.15</size></box></geometry><material><ambient>0.92 0.48 0.05 1</ambient><diffuse>0.98 0.62 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <model name="coffee_mug">
      <!-- Yaw +90 deg puts the handle on the robot-facing (-Y) side. -->
      <pose>0.02 -0.30 0.555 0 0 1.5708</pose>
      <link name="mug">
        <inertial><mass>0.25</mass><inertia><ixx>0.0004</ixx><iyy>0.0004</iyy><izz>0.0003</izz></inertia></inertial>
        <collision name="body"><geometry><cylinder><radius>0.045</radius><length>0.14</length></cylinder></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision>
        <collision name="handle_top"><pose>-0.062 0 0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <collision name="handle_side"><pose>-0.088 0 0 0 0 0</pose><geometry><box><size>0.018 0.018 0.080</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <collision name="handle_bottom"><pose>-0.062 0 -0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <visual name="body_visual"><geometry><cylinder><radius>0.045</radius><length>0.14</length></cylinder></geometry><material><ambient>0.82 0.82 0.78 1</ambient><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
        <visual name="handle_top_visual"><pose>-0.062 0 0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry><material><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
        <visual name="handle_side_visual"><pose>-0.088 0 0 0 0 0</pose><geometry><box><size>0.018 0.018 0.080</size></box></geometry><material><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
        <visual name="handle_bottom_visual"><pose>-0.062 0 -0.035 0 0 0</pose><geometry><box><size>0.055 0.018 0.018</size></box></geometry><material><diffuse>0.95 0.95 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <model name="apple">
      <pose>0 -0.30 0.532 0 0 0</pose>
      <link name="apple">
        <inertial><mass>0.16</mass><inertia><ixx>0.00013</ixx><iyy>0.00013</iyy><izz>0.00013</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.047</radius></sphere></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface></collision>
        <visual name="fruit"><geometry><sphere><radius>0.047</radius></sphere></geometry><material><ambient>0.55 0.03 0.025 1</ambient><diffuse>0.82 0.05 0.04 1</diffuse><specular>0.25 0.25 0.25 1</specular></material></visual>
        <visual name="stem"><pose>0 0 0.052 0 0 0</pose><geometry><cylinder><radius>0.004</radius><length>0.025</length></cylinder></geometry><material><diffuse>0.18 0.08 0.025 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Large object 1: tissue box, 17 x 12 x 9.5 cm. -->
    <model name="tissue_box">
      <pose>0.02 -0.30 0.5325 0 0 0</pose>
      <link name="box">
        <inertial><mass>0.45</mass><inertia><ixx>0.0016</ixx><iyy>0.0010</iyy><izz>0.0021</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.17 0.12 0.095</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><box><size>0.17 0.12 0.095</size></box></geometry><material><ambient>0.75 0.20 0.35 1</ambient><diffuse>0.90 0.30 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Large object 2: storage crate, 26 x 20 x 13 cm, too large for the
         gripper opening - grasped with the dual top-press strategy. -->
    <model name="storage_box">
      <pose>0 -0.31 0.55 0 0 0</pose>
      <link name="box">
        <inertial><mass>0.90</mass><inertia><ixx>0.0055</ixx><iyy>0.0045</iyy><izz>0.0070</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.26 0.20 0.13</size></box></geometry><surface><contact><ode><max_vel>0.1</max_vel><min_depth>0.002</min_depth></ode></contact></surface></collision>
        <visual name="visual"><geometry><box><size>0.26 0.20 0.13</size></box></geometry><material><ambient>0.20 0.42 0.20 1</ambient><diffuse>0.30 0.60 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>1.85 1.45 1.30 0 0.33 -2.45</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
